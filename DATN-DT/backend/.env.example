# ========== LOCAL DEV ==========
NODE_ENV=development
PORT=3000
CONNECT_DB=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/datn?appName=Cluster0

CLOUD_DINARY_NAME=your_cloudinary_name
CLOUD_DINARY_KEY=your_cloudinary_key
CLOUD_DINARY_SECRET=your_cloudinary_secret

SECRET_CRYPTO=your_secret_key_random_string

EMAIL_USER=your_email@gmail.com
CLIENT_ID=your_google_oauth_client_id
CLIENT_SECRET=your_google_oauth_client_secret
REDIRECT_URI=http://localhost:5173
REFRESH_TOKEN=your_refresh_token

URL_CLIENT=http://localhost:5173
URL_IMAGE=http://localhost:3000
GROQ_API_KEY=your_groq_api_key

# ========== RAILWAY — 1 service (backend + frontend gộp chung) ==========
# KHÔNG set PORT — Railway tự inject
# NODE_ENV=production
# CONNECT_DB=<mongodb atlas uri>
# SECRET_CRYPTO=<secret>
# GROQ_API_KEY=<groq key>
# URL_CLIENT=https://datndt-production.up.railway.app
# URL_IMAGE=https://datndt-production.up.railway.app
# REDIRECT_URI=https://datndt-production.up.railway.app
# --- Biến build frontend (bắt buộc trước khi deploy) ---
# VITE_API_URL=https://datndt-production.up.railway.app
# VITE_URL_IMAGE=https://datndt-production.up.railway.app
# VITE_SECRET_CRYPTO=<cùng SECRET_CRYPTO>
# VITE_CLIENT_ID=<google client id>
